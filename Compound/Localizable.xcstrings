    },
    "Uneven · %lld weights" : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Uneven · %lld weight"
                }
              },
              "other" : {
