    "Google" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google"
          }
        }
      }
    },
    "Google doesn't use your data to train its models. Your chats are saved so you can come back to them, and you can delete them, or withdraw this permission, from Settings at any time. The coach can make mistakes and isn't medical advice." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google no usa tus datos para entrenar sus modelos. Tus chats se guardan para que puedas volver a ellos, y puedes eliminarlos o retirar este permiso desde Ajustes en cualquier momento. El entrenador puede equivocarse y no es consejo médico."
          }
        }
      }
    },
