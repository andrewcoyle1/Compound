    "Trans Fat" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grasa trans"
          }
        }
      }
    },
    "Treating a body fat reading from the last 90 days as trustworthy is Compound's own choice: the app cannot tell a DEXA scan from a bathroom scale." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dar por fiable una lectura de grasa corporal de los últimos 90 días es una decisión propia de Compound: la app no distingue un escáner DEXA de una báscula de baño."
          }
        }
      }
    },
    "Treats this device as a subscriber without a purchase. Debug and Mock builds only — it does not exist in a release build." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trata este dispositivo como suscriptor sin compra. Solo en compilaciones Debug y Mock: no existe en una compilación de lanzamiento."
          }
        }
      }
    },
