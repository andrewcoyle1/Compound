    "Button" : {
      "shouldTranslate" : false
    },
    "By continuing, you agree to our [Terms of Service](%@) and [Privacy Policy](%@)" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al continuar, aceptas nuestros [Términos del servicio](%1$@) y nuestra [Política de privacidad](%2$@)"
          }
        }
      }
    },
    "By continuing, you confirm that:\n• You have read and accept the Health Disclaimer.\n• You have read and accept the Consumer Health Privacy Notice.\n\nYou understand Compound does not provide medical advice and is for educational use only. You can review these terms at any time in Settings." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Al continuar, confirmas que:\n• Has leído y aceptas el Aviso de salud.\n• Has leído y aceptas el Aviso de privacidad de datos de salud del consumidor.\n\nEntiendes que Compound no ofrece asesoramiento médico y es solo para uso educativo. Puedes revisar estos términos en cualquier momento en Ajustes."
          }
        }
      }
    },
