{
  "name": "dialedin-functions",
  "description": "Firebase Cloud Functions for DialedIn",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "test:triggers": "firebase emulators:exec --only firestore --project demo-dialedin \"node --test functions.test.js\"",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:rules": "firebase emulators:exec --only firestore --project demo-dialedin 'node --test rules.test.js'"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@genkit-ai/vertexai": "^1.29.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^7.4.0",
    "genkit": "^1.29.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-functions-test": "^3.1.0"
  },
  "private": true
}
