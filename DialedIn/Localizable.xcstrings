        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganar peso de forma saludable requiere tiempo y dedicación. Céntrate en alimentos ricos en nutrientes y en un entrenamiento de fuerza progresivo. Tu cuerpo agradecerá el esfuerzo constante."
          }
        }
      }
