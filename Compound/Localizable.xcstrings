          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Llevas una racha de %lld semana. Compound puede recordártelo por la tarde cuando el objetivo de la semana necesite una sesión ese día."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Llevas una racha de %lld semanas. Compound puede recordártelo por la tarde cuando el objetivo de la semana necesite una sesión ese día."
                }
              }
            }
          }
        }
      }
    },
    "You're ready to start compounding." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya puedes empezar a progresar."
          }
        }
      }
    },
    "You've Got This!" : {
      "localizations" : {
