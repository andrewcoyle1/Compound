    "Dietary Fiber" : {
      "comment" : "A label for dietary fiber.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fibra alimentaria"
          }
        }
      }
    },
    "Diets of 800 calories or less are meant to be followed under medical supervision, so Compound doesn't offer a lower floor." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las dietas de 800 calorías o menos deben seguirse bajo supervisión médica, así que Compound no ofrece un mínimo más bajo."
          }
        }
      }
    },
    "Difference" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
