    "1–2 sessions per week" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1–2 sesiones por semana"
          }
        }
      }
    },
    "2.0 g per kg a day: a margin above that for people who train hard." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2,0 g por kg al día: un margen por encima para quienes entrenan duro."
          }
        }
      }
    },
    "2.2 g per kg a day: the top of the range studies support for building muscle." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2,2 g por kg al día: lo más alto del rango que respaldan los estudios para ganar músculo."
          }
        }
      }
    },
    "2.6 g per kg a day: for lean lifters cutting hard. No guideline recommends this much for everyone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2,6 g por kg al día: para levantadores delgados en una definición agresiva. Ninguna directriz recomienda tanto para todo el mundo."
          }
        }
      }
    },
    "20% of calories from carbs, with fat making up the rest." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El 20% de las calorías de los carbohidratos, y la grasa completa el resto."
          }
        }
      }
    },
    "20% of calories from fat, the lowest guidelines advise, so more carbs." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El 20% de las calorías de la grasa, lo mínimo que aconsejan las directrices, así que más carbohidratos."
          }
        }
      }
    },
    "24 Hour" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 horas"
          }
        }
      }
    },
    "3-4 times per week" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3-4 veces por semana"
          }
        }
      }
    },
    "30% of calories from fat, with carbs making up the rest." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El 30% de las calorías de la grasa, y los carbohidratos completan el resto."
          }
        }
      }
    },
    "3–20 characters: letters, numbers, underscores and dots. Friends can find you by it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3–20 caracteres: letras, números, guiones bajos y puntos. Tus amigos pueden encontrarte con él."
          }
        }
      }
    },
    "3–4 sessions per week" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
