    },
    "The coach reads your workouts, nutrition, body data and steps to answer, through Google's Gemini model in the EU. It never reads progress photos, people you follow, or Strava activities." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para responder, el entrenador lee tus entrenamientos, tu nutrición, tus datos corporales y tus pasos, mediante el modelo Gemini de Google en la UE. Nunca lee fotos de progreso, las personas que sigues ni actividades de Strava."
          }
        }
      }
    },
    "The coach stops reading your data and every chat is deleted." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El entrenador deja de leer tus datos y se eliminan todos los chats."
