          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores anteriores proceden de la última vez que completaste este entrenamiento dentro del mesociclo actual. Si no hay ninguno para un ejercicio, se muestra la última vez que lo hiciste en cualquier lugar."
          }
        }
      }
    },
    "Previous values come from the last time you completed this workout, in any mesocycle. If this workout has no history for an exercise, the last time you performed it anywhere is shown instead." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores anteriores proceden de la última vez que completaste este entrenamiento, en cualquier mesociclo. Si este entrenamiento no tiene historial de un ejercicio, se muestra la última vez que lo hiciste en cualquier lugar."
          }
        }
      }
    },
    "Previous values show the weight, reps, and RIR from the last time you performed this exercise, in any workout at all." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores anteriores muestran el peso, las repeticiones y las RIR de la última vez que hiciste este ejercicio, en cualquier entrenamiento."
