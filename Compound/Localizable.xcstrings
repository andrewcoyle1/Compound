          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ejercicios de la máquina elegida también usan esta. Con Ninguno, es una máquina propia que puedes elegir al crear un ejercicio."
          }
        }
      }
    },
    "Exercises performed with both sides at once, but each limb works independently on its own path." : {
      "localizations" : {
