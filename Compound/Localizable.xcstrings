          }
        }
      }
    },
    "There is no help site yet. In the meantime, Support emails us directly and we will answer you there." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay un sitio de ayuda. Mientras tanto, Soporte nos envía un correo directamente y te responderemos por ahí."
          }
        }
      }
    },
    "These are saved mesocycle designs. Start one from a template to generate a schedule." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos son diseños de mesociclo guardados. Empieza uno a partir de una plantilla para generar un calendario."
          }
