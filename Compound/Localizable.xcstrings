    "Day-to-day weight varies by about half a percent of body weight from water and food alone, so the trend lags a real change by a week or two." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El peso varía de un día a otro en torno a medio por ciento del peso corporal solo por el agua y la comida, así que la tendencia refleja un cambio real con una o dos semanas de retraso."
          }
        }
      }
    },
    "Days" : {
