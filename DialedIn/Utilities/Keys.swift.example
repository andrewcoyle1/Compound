struct Keys {

    // MARK: - API Keys

    static let openAI = ""  // Add your OpenAI API key here
    static let mixpanelToken = ""  // Add your Mixpanel token here
    static let revenueCatAPIKey = ""  // Add your RevenueCat API key here
    static let stravaClientId = ""       // Strava application Client ID
    static let stravaClientSecret = ""   // Strava application Client Secret

    // MARK: - Manager Keys
    // Unique keys for local persistence paths and analytics event prefixes.
    // Changing a value orphans any data already persisted under the old key.

    // User
    static let userManagerKey = "user"
    static let userGoalManagerKey = "user_goal"
    static let followingUsersManagerKey = "following_users"

    // Training
    static let userExerciseManagerKey = "user_exercise_model"
    static let systemExerciseManagerKey = "system_exercise_model"
    static let workoutTemplateManagerKey = "workout_template"
    static let systemWorkoutTemplateManagerKey = "system_workout_template"
    static let userWorkoutSessionManagerKey = "user_workout_session"
    static let followingWorkoutSessionsManagerKey = "following_workout_sessions"
    static let activeWorkoutSessionManagerKey = "active_workout_session"
    static let mesocycleManagerKey = "training_program"
    static let gymProfileManagerKey = "gym_profile"

    // Nutrition
    static let foodManagerKey = "food"
    static let recipeTemplateManagerKey = "recipe_template"
    static let dietPlanManagerKey = "diet_plan"
    static let mealLogManagerKey = "meal_log"
    static let draftMealLogManagerKey = "draft_meal_log"

    // Health
    static let bodyMeasurementsManagerKey = "body_measurements"
    static let stepsManagerKey = "steps"

    // Settings
    static let exerciseSettingsManagerKey = "exercise_settings"
    static let workoutSettingsManagerKey = "workout_settings"
    static let foodLogSettingsManagerKey = "food_log_settings"
    static let nutritionStrategySettingsManagerKey = "nutrition_strategy_settings"
    static let nutritionDayAnnotationManagerKey = "nutrition_day_annotations"
    static let loggingBreakManagerKey = "logging_break"
    static let checkInRecordManagerKey = "check_in_record"
    static let analyticsSettingsManagerKey = "analytics_settings"
    static let shortcutSettingsManagerKey = "shortcut_settings"
}
